{
  "name": "MHA Samadhan - spoken status callback",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mha-status-callback",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Callback requested",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ],
      "webhookId": "mha-status-callback",
      "notes": "Header Auth, not an IF node comparing against $env. This n8n runs with N8N_RUNNERS_ENABLED=true, which blocks $env inside expressions - a gate built on it fails silently rather than refusing. Header Auth is enforced by n8n before any node runs, so an unauthenticated request never reaches the dialler."
    },
    {
      "parameters": {
        "resource": "call",
        "from": "={{ $json.body.from }}",
        "to": "={{ $json.body.to }}",
        "options": {
          "statusCallback": "={{ $json.body.statusUrl }}"
        },
        "twiml": true,
        "message": "={{ '<Response><Redirect>' + $json.body.twimlUrl + '</Redirect></Response>' }}"
      },
      "id": "dial",
      "name": "Place the call",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        -20,
        0
      ],
      "notes": "Every value comes from the request body, because $env is unavailable here. A Redirect rather than inline TwiML: the portal decides what is said, in the citizen's chosen language, at the moment the call connects - so nothing about anybody's grievance passes through this workflow."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, sid: $json.sid }) }}",
        "options": {}
      },
      "id": "ok",
      "name": "Report the SID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ]
    }
  ],
  "connections": {
    "Callback requested": {
      "main": [
        [
          {
            "node": "Place the call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Place the call": {
      "main": [
        [
          {
            "node": "Report the SID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}