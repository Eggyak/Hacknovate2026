# Copy to .env on the VPS and fill in. .env is gitignored and must stay that way.
PUBLIC_URL=https://hacknovate2026.visioncoders.in

POSTGRES_USER=mha
POSTGRES_PASSWORD=<generate a long random string>
POSTGRES_DB=mha_samadhan

# openssl rand -hex 32
JWT_SECRET=<64 hex characters>

# Azure Speech resource (speech-to-text + text-to-speech).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# Azure Translator is a SEPARATE resource from Speech, with its own key and
# its own region. All 14 portal languages are supported by it. Leave blank and
# the LLM covers translation instead; leave both blank and complaints are
# filed in the original language with no English rendering, which affects
# neither routing nor filing.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia

# Mistral. Used to settle routing the keyword pass could not, and to produce
# the English rendering when no Azure Translator key is set. Optional: without
# it the system falls back to keywords alone, which is the normal path anyway.
# NOTE: free accounts meter quota PER MODEL - a model can sit at zero while
# another on the same key works. Change MISTRAL_MODEL, not the key.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# n8n webhook that hands the OTP to Twilio.
N8N_OTP_WEBHOOK_URL=
N8N_OTP_API_KEY=

SLA_DAYS=21
